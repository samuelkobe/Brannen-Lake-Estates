{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ivory",
					"color": "#FAF7F2",
					"name": "Ivory"
				},
				{
					"slug": "cream",
					"color": "#F2EBE0",
					"name": "Cream"
				},
				{
					"slug": "champagne",
					"color": "#DDC7A9",
					"name": "Champagne"
				},
				{
					"slug": "taupe",
					"color": "#B5A898",
					"name": "Taupe"
				},
				{
					"slug": "sage",
					"color": "#6B7C5E",
					"name": "Sage"
				},
				{
					"slug": "charcoal",
					"color": "#2C2A27",
					"name": "Charcoal"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "xs",   "size": "0.75rem",  "name": "XS"   },
				{ "slug": "sm",   "size": "0.875rem", "name": "SM"   },
				{ "slug": "base", "size": "1rem",     "name": "Base" },
				{ "slug": "lg",   "size": "1.125rem", "name": "LG"   },
				{ "slug": "xl",   "size": "1.25rem",  "name": "XL"   },
				{ "slug": "2xl",  "size": "1.5rem",   "name": "2XL"  },
				{ "slug": "3xl",  "size": "1.875rem", "name": "3XL"  },
				{ "slug": "4xl",  "size": "2.25rem",  "name": "4XL"  },
				{ "slug": "5xl",  "size": "3rem",     "name": "5XL"  },
				{ "slug": "6xl",  "size": "3.75rem",  "name": "6XL"  }
			],
			"fontFamilies": [
				{
					"slug": "cormorant",
					"name": "Cormorant Garamond",
					"fontFamily": "'Cormorant Garamond', serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/CormorantGaramond-VariableFont_wght.ttf" ]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontWeight": "300 700",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/CormorantGaramond-Italic-VariableFont_wght.ttf" ]
						}
					]
				},
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "'DM Sans', sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/DMSans-VariableFont_opsz,wght.ttf" ]
						},
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 900",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/DMSans-Italic-VariableFont_opsz,wght.ttf" ]
						}
					]
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "10", "size": "0.25rem",  "name": "XS"  },
				{ "slug": "20", "size": "0.5rem",   "name": "S"   },
				{ "slug": "30", "size": "1rem",     "name": "M"   },
				{ "slug": "40", "size": "1.5rem",   "name": "L"   },
				{ "slug": "50", "size": "2rem",     "name": "XL"  },
				{ "slug": "60", "size": "3rem",     "name": "2XL" },
				{ "slug": "70", "size": "5rem",     "name": "3XL" },
				{ "slug": "80", "size": "8rem",     "name": "4XL" }
			],
			"units": [ "px", "%", "em", "rem", "vh", "vw" ]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true
	},
	"customTemplates": [
		{
			"name": "page-hero",
			"title": "Hero Page (Full-bleed, no title)",
			"postTypes": [ "page" ]
		}
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--charcoal)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--dm-sans)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant)",
					"fontWeight": "300",
					"fontStyle": "italic"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant)",
					"fontWeight": "300"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant)",
					"fontWeight": "400"
				}
			}
		}
	}
}
