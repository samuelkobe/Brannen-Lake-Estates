{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"blocks/**/*.ts",
		"vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"assets"
	]
}
